<div class='route'>
<h2><%= t('departures.title') %></h2>
<% if @stops.present? %>
<% @stops.each_with_index do |stop, index| %>
<%= link_to "#{index + 1} #{stop['name']}", departures_stop_path(id: stop['id']), accesskey: (index + 1).to_s %><br />
<% end %>
<br />
<%= link_to "8 #{t('departures.add_stop')}", departures_add_path, accesskey: "8" %><br />
<%= link_to "9 #{t('departures.forget_stops')}", departures_forget_path, accesskey: "9" %>
<% else %>
<%= t('departures.none_saved') %><br /><br />
<%= link_to "1 #{t('departures.find_stops')}", departures_add_path, accesskey: "1" %>
<% end %>
<br /><br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
<%= render "credit" %>
</div>
