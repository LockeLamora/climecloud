<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= Languages.direction_for(I18n.locale) %>">
  <head>
    <title>Climecloud</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# No script tag of any kind. See the Gemfile. %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <%# Themes.resolve, not the raw cookie: an unrecognised name becomes the default rather %>
  <%# than reaching the markup. %>
  <body data-theme="<%= Themes.resolve(cookies[:theme]) %>">
    <%= yield %>
  </body>
</html>
