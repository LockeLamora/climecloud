<!DOCTYPE html>
<%# Themes.resolve, not the raw cookie: an unrecognised name becomes the default rather %>
<%# than reaching the markup or the stylesheet below. %>
<% theme = Themes.resolve(cookies[:theme]) %>
<html lang="<%= I18n.locale %>" dir="<%= Languages.direction_for(I18n.locale) %>">
  <head>
    <title>Climecloud</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# No script tag of any kind. See the Gemfile. %>
    <%= stylesheet_link_tag "application" %>

    <%# Must follow the link tag: the palette reuses the components' selectors, so it wins %>
    <%# on source order rather than on specificity. %>
    <%= theme_style_tag theme %>
  </head>

  <body data-theme="<%= theme %>">
    <%= yield %>
  </body>
</html>
