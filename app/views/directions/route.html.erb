<div class='route'>
<%= glyph_text "#{@start} to #{@end}" %><br />
<% Array(@ambiguous).each do |field| %>
<%= link_to "(#{t('directions.wrong_endpoint', field: field_label(field))})",
            directions_pick_path(@route_params.merge('field' => field).merge(bias_params_for(field))) %><br />
<% end %>
<%= glyph_text @overall_time.to_s %><br />
<%= link_to "(#{t('directions.switch_turn_by_turn')})", directions_plan_path(@route_params.merge(view: 'turn', step: 0)) %>
<br />
<img src="data:image/png;base64,<%= @image %>" />
<br /><br />
<% if glyph_theme %>
<% rows = @steps.each_with_index.map do |step, i|
     "#{i}- #{step["distance"]["text"]}(#{step["duration"]["text"]}) #{strip_tags(step["html_instructions"])}"
   end %>
<%= glyph_screen(rows) %>
<% else %>
<% @steps.each_with_index do |step, i| %>
    <ol>
<%= "<b>#{i}</b>- #{step["distance"]["text"]}(#{step["duration"]["text"]})<br /> #{step["html_instructions"]}".html_safe %>
    </ol>
<% end %>
<% end %>
<%# Zero is the menu on every page. Last on this one, since the route can run to a %>
<%# screenful of steps, which is where the turn by turn view keeps it too. %>
<br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
