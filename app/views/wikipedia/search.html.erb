<div class='news'>
<h2><%= phosphor_text t('wikipedia.title') %></h2>
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<%= form_with url: "wikipedia", method: :get, local: true do |f| %>
    <%= f.label t('wikipedia.search_label') %>
    <%= f.text_field :query, value: @query, class: "big_text_field" %>
    <br /><br />
    <%= f.submit t('common.search') %>
<% end %>
<% if @results.present? %>
<br />
<ol>
<% @results.each_with_index do |result, index| %>
    <li><%= link_to "#{index + 1} #{result[:title]}",
                    wikipedia_article_path(title: result[:title]),
                    accesskey: (index + 1).to_s %><br />
    <%= phosphor_theme ? phosphor_glyph(result[:snippet].to_s, keep_case: true) : result[:snippet] %></li>
<% end %>
</ol>
<% elsif @query.present? && @error.nil? %>
<br />
<%= phosphor_text t('wikipedia.nothing_found', query: @query) %><br />
<% end %>
<br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
