<div class='news'>
<b><%= @article ? @article[:title] : @title %></b><br />
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<% if @article %>
<br />
<%= simple_format(@article[:extract]) %>
<% unless @full %>
<%= link_to "1 Read the full article", wikipedia_article_path(title: @article[:title], full: '1'), accesskey: "1" %><br />
<% end %>
<% end %>
<br />
<%= link_to "9 Search again", wikipedia_path, accesskey: "9" %><br />
<%= link_to "0 Back to menu", root_path, accesskey: "0" %>
</div>
