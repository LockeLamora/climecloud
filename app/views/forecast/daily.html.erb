<h1><%= glyph_text t('forecast.daily_title'), heading: true %></h1>
<%= glyph_text "#{cookies["city"]}, #{cookies["state"]}" %><br />
<%=link_to "1 #{t('forecast.switch_to_hourly')}", "/forecast/hourly", accesskey: "1" %>

<%# One line per day on every style; see the hourly view. The year is off the front of the
    date, this being seven days out, and the ranges carry their unit once. %>
<% header = "#{t('forecast.date')} #{@units[:temp]} #{@units[:wind].upcase} #{t('forecast.precip')}" %>
<% rows = @times.each_index.map do |i|
     row = "#{@times[i].split('-', 2).last} #{@temps_min[i].round}-#{@temps_max[i].round}° " \
           "#{@wind_min[i].round}-#{@wind_max[i].round} #{forecast_rain(@rain[i], @rain_prob[i])}"
     row += " #{t('forecast.snow').upcase} #{@snow[i].round}#{@units[:snowfall]}" if @snow[i].positive?
     row
   end %>
<% if glyph_theme %>
<%= glyph_screen([header.upcase] + rows) %>
<% else %>
<br />
<div class="forecast">
<b><%= header %></b><br />
<% rows.each do |row| %>
<%= row %><br />
<% end %>
</div>
<% end %>
  <br /><br />
  <%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
  <%= render "credit" %>
