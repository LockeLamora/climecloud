<h1><%= phosphor_text t('forecast.hourly_title') %></h1>
<%= phosphor_text "#{cookies["city"]}, #{cookies["state"]}" %><br />
<%=link_to "1 #{t('forecast.switch_to_daily')}", "/forecast/daily", accesskey: "1" %>
<%# One line per hour on every style, the columns aligned by the monospace where the theme
    has one. A table of cells at four columns on a 240px screen wraps its own brackets onto
    lines of their own and clips glyphs mid-character; a line only ever grows downwards,
    which is the direction a phone can scroll.

    The wind unit lives in the header — repeated on every row it pushes the rain off the
    end of the line. Rain shows the chance while it is dry and the amount once rain is
    coming, each being the number that matters in that case. %>
<% header = "#{t('forecast.time')} #{@units[:temp]} #{@units[:wind].upcase} #{t('forecast.precip')}" %>
<% rows = @times.each_index.map do |i|
     row = "#{@times[i].split('T')[1]} #{@temps[i].round}°(#{@feels_like[i].round}) " \
           "#{@wind[i].round} #{forecast_rain(@rain[i], @rain_prob[i])}"
     row += " #{t('forecast.snow').upcase} #{@snow[i].round}#{@units[:snowfall]}" if @snow[i].positive?
     row
   end %>
<% if phosphor_theme %>
<%= phosphor_screen([header.upcase] + rows) %>
<% else %>
<br />
<b><%= header %></b><br />
<% rows.each do |row| %>
<%= row %><br />
<% end %>
<% end %>
  <br /><br />
  <%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
  <%= render "credit" %>
