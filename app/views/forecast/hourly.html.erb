<h1><%= phosphor_text t('forecast.hourly_title') %></h1>
<%= "#{cookies["city"]}, #{cookies["state"]}"%><br />
<%=link_to "1 #{t('forecast.switch_to_daily')}", "/forecast/daily", accesskey: "1" %>
<%# On the phosphor styles the table travels as a few glyph images, each row one monospace
    line — a table of cells is both unlit and, at four columns on a 240px screen, wraps its
    own brackets onto lines of their own. %>
<% if phosphor_theme %>
<% rows = ["TIME #{@units[:temp]}(FEEL) WIND RAIN"] + @times.each_index.map do |i|
     row = "#{@times[i].split('T')[1]} #{@temps[i].round}°(#{@feels_like[i].round}) " \
           "#{@wind[i].round}#{@units[:wind]} #{@rain_prob[i]}%"
     row += " SNOW #{@snow[i]}#{@units[:snowfall]}" if @snow[i].positive?
     row
   end %>
<%= phosphor_screen(rows) %>
<% else %>
<table>
<%# The proportions, or fixed layout splits 215px four equal ways and the temperature
    column wraps its brackets onto lines of their own. %>
<colgroup>
  <col style="width:22%"><col style="width:32%"><col style="width:22%"><col style="width:24%">
</colgroup>
<thead>
    <tr>
      <th><%= t('forecast.time') %></th>
      <th><%= t('forecast.temp_feels') %></th>
      <th><%= t('forecast.wind') %></th>
      <th><%= t('forecast.precip') %> <%= @units[:rain]%></th>
    </tr>
  </thead>

  <tbody>
  <% (@times.length).times do |i| %>
    <tr>
    <td> <%= @times[i].split('T')[1] %></td>
    <td> <%= "#{@temps[i].round}#{@units[:temp]}(#{@feels_like[i].round})"%></td>
    <td> <%= "#{@wind[i].round}#{@units[:wind]}" %></td>
    <% if @snow[i] > 0 %>
    <td> <%= "<b>#{t('forecast.snow')}:</b> #{@snow[i]}#{@units[:snowfall]} (#{@rain_prob[i]}%)".html_safe%></td>
      <% else %>
    <td> <%= "#{@rain[i]}#{@units[:rain]}(#{@rain_prob[i]}%)"%></td>
    <% end %>
    </tr>
  <% end %>
  </tbody>
  </table>
<% end %>
  <br /><br />
  <%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
  <%= render "credit" %>
