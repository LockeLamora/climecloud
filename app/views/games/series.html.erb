<div class='games'>
<b><%= glyph_text @books.first['series'], heading: true %></b><br /><br />
<%# A long series runs in arcs — the Kai books, then the Magnakai — and a volume that %>
<%# names its arc is headed by it. The numbering runs on through the whole series, as %>
<%# the books themselves are numbered. %>
<% arc = nil %>
<% @books.each_with_index do |book, index| %>
<% if book['arc'] != arc %>
<% arc = book['arc'] %>
<% if arc %>
<b><%= glyph_text arc, heading: true %></b><br /><br />
<% end %>
<% end %>
<%= link_to "#{index + 1} #{book['volume']} - #{book['title']}", games_book_path(book: book['id']), accesskey: (index + 1).to_s %><br /><br />
<% end %>
<%= link_to "9 #{t('games.title')}", games_path, accesskey: "9" %><br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
