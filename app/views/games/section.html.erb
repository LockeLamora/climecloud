<div class='games'>
<b><%= glyph_text @section['title'] || @book['title'], heading: true %></b><br />
<br />
<%= simple_format(@section['text']) if @section['text'].present? %>
<% if (image = @section['image']) %>
<%# Wider than the screen on purpose: the pictures hide objects the footnotes ask %>
<%# the reader to find, so the page is scrolled over the full-size picture rather %>
<%# than shrinking it to fit. %>
<img src="<%= image['src'] %>" width="<%= image['width'] %>" height="<%= image['height'] %>" alt="<%= image['alt'] %>" /><br />
<br />
<% end %>
<%# Only real page turns take a number; a choice without a destination is a %>
<%# consequence the book states and leaves with the reader. %>
<%# Buttons rather than links, as on the nearby-stops list: a page turn moves the %>
<%# bookmark, and a browser that fetches links ahead of the cursor must not turn %>
<%# pages. The POST bookmarks the destination and redirects to its own GET. %>
<% number = 0 %>
<% @section['choices'].each do |choice| %>
<% if choice['to'] %>
<% number += 1 %>
<%= choice_button "#{number} #{choice['label']}", games_turn_path,
                  { book: @book['id'], section: choice['to'] },
                  accesskey: number.to_s %><br /><br />
<% else %>
<%= choice['label'] %><br /><br />
<% end %>
<% end %>
<% if @section['choices'].empty? %>
<b><%= glyph_text t('games.the_end'), heading: true %></b><br />
<br />
<%= link_to "1 #{t('games.restart')}", games_section_path(book: @book['id'], section: @book['start']), accesskey: "1" %><br /><br />
<% end %>
<%= link_to "9 #{@book['title']}", games_book_path(book: @book['id']), accesskey: "9" %><br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
