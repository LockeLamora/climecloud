<div class='games'>
<b><%= glyph_text @section['title'] || @book['title'], heading: true %></b><br />
<br />
<%# The character sheet, for the books that keep one: written by #turn, read here. %>
<%# The rolled maximums are bookkeeping, not news, and stay off the line. %>
<% if @stats.present? %>
<%= glyph_text @stats.reject { |name, _| name.end_with?('_max') }.map { |name, value| "#{name.capitalize} #{value}" }.join(' - ') %><br />
<%= glyph_text "Carrying: #{@items.presence&.map { |held| held.tr(':', ' x') }&.join(', ') || 'nothing'}" %><br />
<% if params[:rolled].present? %>
<%= glyph_text "The Random Number Table gives #{params[:rolled].to_i}." %><br />
<% end %>
<% if params[:used].present? && (spent = @book.dig('consumables', params[:used])) %>
<%= glyph_text "#{spent['label']}: done." %><br />
<% end %>
<% if params[:took].present? %>
<%= glyph_text "Taken: the #{params[:took]}#{params[:gave].present? ? ", given up: the #{params[:gave]}" : ''}." %><br />
<% end %>
<% if params[:got].present? %>
<%= glyph_text "Taken: the #{params[:got]}." %><br />
<% end %>
<% case params[:ate] %>
<% when 'meal' %><%= glyph_text 'You eat a Meal from your pack.' %><br />
<% when 'laumspur' %><%= glyph_text 'You eat a Meal of Laumspur.' %><br />
<% when 'hunting' %><%= glyph_text 'Your Hunting finds food along the way.' %><br />
<% when 'nothing' %><span class='error'><%= glyph_text 'Nothing to eat: endurance -3.', error: true %></span><br />
<% end %>
<% if params[:lost].present? %>
<span class='error'><%= glyph_text "Lost: the #{params[:lost]}.", error: true %></span><br />
<% end %>
<%# The ledger of what the page turn did to the stats: gains plain, losses in red. %>
<% params[:fx].to_s.split(',').each do |change| %>
<% next unless (move = change.match(/\A([a-z_ ]+)([+-]\d+)\z/)) %>
<% if move[2].to_i.negative? %>
<span class='error'><%= glyph_text "#{move[1].capitalize} #{move[2]}.", error: true %></span><br />
<% else %>
<%= glyph_text "#{move[1].capitalize} #{move[2]}." %><br />
<% end %>
<% end %>
<br />
<%# Standing provisions: offered on every page while any remain, in the theme's own %>
<%# good colour so they read apart from the book's choices. A battle draught is the %>
<%# reverse: it appears only while blades are out. %>
<% if !@dead && (pantry = @book['consumables']) %>
<% pantry.each do |name, item| %>
<% next if item['battle'] ? @combat.nil? : @combat %>
<% held = count_of(Array(@items), name) %>
<% next unless held.positive? %>
<%= choice_button "#{item['label']} (#{held} left)", games_use_path,
                  { book: @book['id'], item: name }, css: 'provision' %><br />
<br />
<% end %>
<% end %>
<% end %>
<% if @dead %>
<b><%= glyph_text t('games.the_end'), heading: true %></b><br />
<%= glyph_text 'Your strength is spent, and the story ends here.' %><br />
<br />
<%= choice_button "1 #{t('games.restart')}", games_restart_path, { book: @book['id'] }, accesskey: "1" %><br />
<br />
<% else %>
<%= simple_format(@section['text']) if @section['text'].present? %>
<% if @section['rnt'] %>
<%# Nobody carries the book's random number table: one is drawn here for the reader %>
<%# to use with the section's instructions. Display only — nothing hangs on it %>
<%# server-side, exactly as the paper book trusts the reader with the real table. %>
<%= glyph_text "The Random Number Table gives: #{rand(0..9)}" %><br />
<br />
<% end %>
<% if @section['combat'] %>
<% if params[:rn].present? %>
<%= glyph_text "Random number #{params[:rn].to_i}: the enemy loses #{params[:foe].to_i >= LoneWolf::KILLED ? 'everything' : params[:foe].to_i}, you lose #{params[:you].to_i}." %><br />
<% end %>
<% if @combat %>
<% foe, remaining = @combat %>
<%= glyph_text "#{foe['name']}: Combat Skill #{foe['skill']} - Endurance #{remaining}#{@round.to_i.positive? ? " - Round #{@round + 1}" : ''}" %><br />
<%# The weapon is the engine's pick, not the reader's: every weapon strikes alike, %>
<%# so the skilled one counts whenever it is held. This line shows what counts. %>
<% if (arm = armament(@book, Array(@items))) %>
<% weapon, worth = arm %>
<%= glyph_text "Fighting #{weapon == 'bare hands' ? 'bare-handed' : "with the #{weapon}"}#{worth.zero? ? '' : " (skill #{format('%+d', worth)})"}." %><br />
<% end %>
<br />
<%= choice_button 'Fight a round of combat', games_turn_path,
                  { book: @book['id'], from: params[:section], choice: 'fight' } %><br />
<br />
<% if (flight = @section.dig('combat', 'evade')) && @round.to_i >= flight.fetch('after', 0) %>
<%= choice_button flight['label'] || 'Evade the fight', games_turn_path,
                  { book: @book['id'], from: params[:section], choice: 'evade' } %><br />
<br />
<% end %>
<% else %>
<%= glyph_text 'The fight is won.' %><br />
<br />
<% end %>
<% end %>
<% if (image = @section['image']) %>
<%# Wider than the screen on purpose: the pictures hide objects the footnotes ask %>
<%# the reader to find, so the page is scrolled over the full-size picture rather %>
<%# than shrinking it to fit. %>
<img src="<%= image['src'] %>" width="<%= image['width'] %>" height="<%= image['height'] %>" alt="<%= image['alt'] %>" /><br />
<br />
<% end %>
<%# Standing offers: things the page says the reader may take, in the good colour %>
<%# like the provisions. Each withdraws once it is held or barred. Offered mid-fight %>
<%# too — the sword at your feet is most wanted with the blades out. %>
<% Array(@section['offers']).each do |offer| %>
<% next unless offer_open?(@book, offer, Array(@items)) %>
<%= choice_button offer['label'] || "Take the #{offer['item']}", games_take_path,
                  { book: @book['id'], item: offer['item'] }, css: 'provision' %><br /><br />
<% end %>
<%# Only real page turns take a number; a choice without a destination is a %>
<%# consequence the book states and leaves with the reader, and a choice whose kit or %>
<%# toll is missing shows what it wanted rather than vanishing — in the theme's error %>
<%# colour, so a barred way reads barred at a glance. A stat fork shows only the line %>
<%# that is true, as the paper reader follows it; choices wait while a fight is on. %>
<%# Buttons rather than links: a page turn moves the bookmark, and a browser that %>
<%# fetches links ahead of the cursor must not turn pages. Each button names its %>
<%# place in the section; the destination is the server's to decide. %>
<% if @combat.nil? %>
<% number = 0 %>
<% @section['choices'].each_with_index do |choice, index| %>
<% if choice['to'].nil? && choice['test'].nil? && choice['pick'].nil? %>
<%= choice['label'] %><br /><br />
<% elsif !within?(choice['when'], @stats) %>
<% elsif choice['without'] && Array(@items).include?(choice['without']) %>
<% elsif choice['needs'] && !Array(@items).include?(choice['needs']) %>
<span class='error'><%= glyph_text "#{choice['label']} (needs the #{choice['needs']})", error: true %></span><br /><br />
<% elsif (choice['cost'] || {}).any? { |stat, price| (@stats || {}).fetch(stat, 0) < price } %>
<span class='error'><%= glyph_text "#{choice['label']} (#{choice['cost'].map { |stat, price| "#{stat} #{price}" }.join(', ')} - not enough)", error: true %></span><br /><br />
<% else %>
<% number += 1 %>
<% price = (choice['cost'] || {}).map { |stat, cost| " (#{stat} -#{cost})" }.join %>
<% trial = choice['test'] ? " (test #{choice['test']['stat']})" : '' %>
<%= choice_button "#{number} #{choice['label']}#{price}#{trial}", games_turn_path,
                  { book: @book['id'], from: params[:section], choice: index },
                  accesskey: number.to_s %><br /><br />
<% end %>
<% end %>
<% if @section['choices'].empty? %>
<b><%= glyph_text t('games.the_end'), heading: true %></b><br />
<br />
<%= choice_button "1 #{t('games.restart')}", games_restart_path, { book: @book['id'] }, accesskey: "1" %><br /><br />
<% end %>
<% end %>
<% end %>
<%= link_to "9 #{@book['title']}", games_book_path(book: @book['id']), accesskey: "9" %><br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
