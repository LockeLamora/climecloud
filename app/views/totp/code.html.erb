<div class='route'>
<b><%= glyph_text @account['name'], heading: true %></b><br /><br />
<%# Grouped in threes, the way anyone reads a code back to a login form. %>
<h1><%= glyph_text "#{@code[0, 3]} #{@code[3, 3]}", heading: true %></h1>
<%= glyph_text t('totp.seconds_left', seconds: @seconds) %><br /><br />
<%= link_to "1 #{t('totp.refresh')}", totp_code_path(name: @account['name']), accesskey: "1" %><br /><br />
<% if @reveal %>
<%# The key as the site issued it, for writing down or enrolling elsewhere: this cookie is
    the only copy, and losing it is being locked out. %>
<%= glyph_text t('totp.secret_is') %><br />
<b><%= setup_key @account['secret'] %></b><br /><br />
<% else %>
<%= link_to "8 #{t('totp.show_secret')}", totp_code_path(name: @account['name'], reveal: '1'),
            accesskey: "8" %><br /><br />
<% end %>
<%# A link to the question, not the deletion itself: the only copy of this secret is the
    cookie, so one slip of a thumb must not be enough. %>
<%= link_to "7 #{t('totp.forget_account')}", totp_confirm_path(name: @account['name']),
            accesskey: "7" %><br />
<%= link_to "9 #{t('totp.back_to_codes')}", totp_path, accesskey: "9" %><br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
