<div class='route'>
<b><%= t("places.category.#{params[:kind]}") %></b><%= " #{t('places.near').downcase} #{@place}" if @place.present? %><br />
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<%# Toilets returns supermarkets and cafes as well as public conveniences, so say why %>
<%# before the list rather than leave a cafe looking like a mistake. %>
<% if params[:kind] == 'toilets' && @places.any? %>
<%= t('places.toilets_hint') %><br />
<% end %>
<% if @places.empty? && @error.nil? %>
<%= t('places.nothing_found', radius: @radius / 1000) %><br />
<% end %>
<ol>
<% @places.each_with_index do |place, index| %>
    <li><%= link_to place[:name], directions_plan_path(origin: "#{@lat},#{@lon}",
                                                       destination: "#{place[:lat]},#{place[:lon]}",
                                                       mode: 'walking'),
                    accesskey: index < 8 ? (index + 1).to_s : nil %><br />
    <%# Type and charge for a car park, so the choice is made here rather than after %>
    <%# walking to it. Anything the data does not say is left unsaid. %>
    <%= (([place[:kind], place_distance(place[:distance])].compact) + place[:notes].to_a).join(', ') %>
    <% if place[:hours].present? %>
    <br /><%= t('places.hours') %>: <%= opening_hours(place[:hours]) %>
    <% end %></li>
<% end %>
</ol>
<br />
<%= link_to "9 #{t('places.back_to_places')}", places_path(carried_location), accesskey: "9" %>
<%= render "shared/osm_credit" %>
</div>
