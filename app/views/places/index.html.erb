<div class='route'>
<h2><%= phosphor_text t('places.title') %></h2>
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<% if @place.present? %>
<%= phosphor_text "#{t('places.near')} #{@place}" %><br />
<% end %>
<br />
<% @kinds.each_with_index do |kind, index| %>
<%= link_to "#{index + 1} #{t("places.category.#{kind}")}",
            places_list_path(carried_location.merge(kind: kind)),
            accesskey: (index + 1).to_s %><br />
<% end %>
<br />
<% if @more_kinds %>
<%= link_to "9 #{t('places.more_categories')}",
            places_path(carried_location.merge(page: @page + 1)), accesskey: "9" %><br /><br />
<% end %>
<% if @page.positive? %>
<%= link_to "9 #{t('places.previous_categories')}",
            places_path(carried_location.merge(page: @page - 1)), accesskey: "9" %><br /><br />
<% end %>
<% if @saved.present? %>
<b><%= t('places.saved') %></b><br />
<% @saved.each do |saved| %>
<%= link_to saved['place'], places_path(lat: saved['lat'], lon: saved['lon'], place: saved['place']) %><br />
<% end %>
<%= button_to "(#{t('places.forget')})", places_forget_path, method: :delete, form_class: "inline-action" %>
<br /><br />
<% end %>
<%= form_with url: "places_search", method: :get, local: true do |f| %>
    <%= f.label t('places.somewhere_else') %>
    <%= f.text_field :query, class: "big_text_field" %>
    <br /><br />
    <%= f.submit t('common.search') %>
<% end %>
<br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
<%= render "shared/osm_credit" %>
</div>
