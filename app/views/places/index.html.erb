<div class='route'>
<h2>Places</h2>
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<% if @place.present? %>
Near <%= @place %><br />
<% end %>
<br />
<% Places::CATEGORIES.each_with_index do |(kind, details), index| %>
<%= link_to "#{index + 1} #{details[:label]}",
            places_list_path(carried_location.merge(kind: kind)),
            accesskey: (index + 1).to_s %><br />
<% end %>
<br />
<% if @saved.present? %>
<b>Saved places</b><br />
<% @saved.each do |saved| %>
<%= link_to saved['place'], places_path(lat: saved['lat'], lon: saved['lon'], place: saved['place']) %><br />
<% end %>
<%= link_to "(Forget saved places)", places_forget_path %>
<br /><br />
<% end %>
<%= form_with url: "places_search", method: :get, local: true do |f| %>
    <%= f.label "Somewhere else:" %>
    <%= f.text_field :query, class: "big_text_field" %>
    <br /><br />
    <%= f.submit "Search" %>
<% end %>
<br />
<%= link_to "0 Back to menu", root_path, accesskey: "0" %>
</div>
