<div class='route'>
<%= t('common.which_did_you_mean') %><br />
<b><%= params[:query] %></b>
<br /><br />
<ol>
<% @candidates.each do |candidate| %>
    <li><%= link_to candidate[:address], places_path(lat: candidate[:lat],
                                                     lon: candidate[:lon],
                                                     place: candidate[:address]) %></li>
<% end %>
</ol>
<br />
<%= link_to "(#{t('common.none_of_these')})", places_path %>
<%= render "shared/osm_credit" %>
</div>
