<div class='route'>
<%= glyph_text t('common.which_did_you_mean') %><br />
<b><%= glyph_text params[:query].to_s, heading: true %></b>
<br /><br />
<%# Buttons rather than links, as on the nearby-stops list: choosing a candidate %>
<%# saves it, and a browser that fetches links ahead of the cursor must not save %>
<%# places the reader scrolled past. %>
<ol>
<% @candidates.each do |candidate| %>
    <li><%= choice_button candidate[:address], places_save_path,
                          { lat: candidate[:lat], lon: candidate[:lon],
                            place: candidate[:address] } %></li>
<% end %>
</ol>
<br />
<%= link_to "(#{t('common.none_of_these')})", places_path %>
<%= render "shared/osm_credit" %>
</div>
