<div class="news">
<%# Roughly a third of articles cannot be shown here: publishers refuse the request, or %>
<%# want a subscription, or lay the story out in a way nothing can find. The headline came %>
<%# from the feed, so it can still say what the story was, and the source link still works. %>
<% if @error.present? %>
<% if @title.present? %><b><%= phosphor_text @title %></b><br /><br /><% end %>
<span class='error'><%= @error %></span><br /><br />
<% end %>
<%= @article %>
<%# Links after the story, so finishing a long article leaves them to hand rather than a %>
<%# scroll back to the top. The accesskeys work wherever the page is scrolled to. %>
<br /><br />
<%= link_to t('news.source_link'), sanitize(@article_url.html_safe) %><br />
<%= link_to "9 #{t('news.back_to_headlines')}", news_path(section: @section), accesskey: "9" %><br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
