<%# The free landing between a headline and its article: rendered entirely from the %>
<%# request, so the cursor prefetching headline links spends nothing. Opening the %>
<%# article is the one POST below — the step that costs Google and the publisher a %>
<%# visit, taken only on a real press. %>
<div class="news">
<b><%= glyph_text @title.to_s, heading: true %></b><br />
<br />
<%= choice_button "1 #{t('news.open_article')}", news_open_path,
                  { article: @article_url, section: @section, title: @title },
                  accesskey: "1" %><br />
<br />
<%= link_to "9 #{t('news.back_to_headlines')}", news_path(section: @section), accesskey: "9" %><br />
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>
