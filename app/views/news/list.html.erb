
<div class='news_topics'>
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<%= phosphor_text @title.to_s %><br /><br />
<%# Nine sections, nine digits, in the reader's own language, so none of them needs %>
<%# scrolling past on a keypad. Zero stays free for the menu, as everywhere else. %>
<% Gnews::SECTIONS.each_with_index do |section, index| %>
<%= link_to "#{index + 1} #{t("news.section.#{section.downcase}")}",
            news_path(section: section), accesskey: (index + 1).to_s %><br />
<% end %>
</div>
<br />
<div class='news_search'>
<%= form_with url:"news_search", method: :get, local: true do |f| %>
    <%= f.label(t('news.search_label')) { phosphor_text t('news.search_label') } %>
    <%= f.text_field :search_query, class: "text_field" %>
    <br /><br />
    <%= f.submit t('common.search') %>
  <% end %>
</div>
<br /><br />
<div class="news">
    <% @news_items.each do |item| %>
            <b><%= phosphor_text item[:item_title] %></b><br />
            <ul>
            <% item[:articles].each do |article| %>
                <%# The section travels with the link so the way back lands on the list %>
                <%# being read, and the headline so an article that will not open can still %>
                <%# say what it was about. %>
                <li><%= link_to article[:article_title],
                                news_article_path(article: article[:article_url],
                                                  section: @section,
                                                  title: article[:article_title]) %></li>
            <% end %>
            </ul>
            <br />
    <% end %>
</div>