
<div class='news_topics'>
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<%= glyph_text @title.to_s %><br /><br />
<%# Nine sections, nine digits, in the reader's own language, so none of them needs %>
<%# scrolling past on a keypad. Zero stays free for the menu, as everywhere else. %>
<% Gnews::SECTIONS.each_with_index do |section, index| %>
<%= link_to "#{index + 1} #{t("news.section.#{section.downcase}")}",
            news_path(section: section), accesskey: (index + 1).to_s %><br />
<% end %>
</div>
<br />
<div class='news_search'>
<%= form_with url:"news_search", method: :get, local: true do |f| %>
    <%= f.label(t('news.search_label')) { glyph_text t('news.search_label') } %>
    <%= f.text_field :search_query, class: "text_field" %>
    <br /><br />
    <%= f.submit t('common.search') %>
  <% end %>
</div>
<br /><br />
<div class="news">
    <% @news_items.each do |item| %>
            <% multi = item[:articles].length > 1 %>
            <%# The heading is the grouping: a story with several sources keeps it, and the
                sources sit indented beneath as outlet names alone — repeating the headline
                per source was the page that would not open, and a bare outlet name with no
                heading above it read as a headline that lost its text. A story with one
                source drops the heading and lets its lead carry the headline itself, or
                the same sentence stacks twice. %>
            <% if multi %>
            <b><%= glyph_text item[:item_title], heading: true %></b><br />
            <% end %>
            <ul>
            <% item[:articles].each do |article| %>
                <%# The section travels with the link so the way back lands on the list %>
                <%# being read, and the headline so an article that will not open can still %>
                <%# say what it was about. %>
                <% label = if multi
                     article[:article_source].presence || article[:article_title]
                   elsif article[:article_source].present?
                     "#{article[:article_title]} (#{article[:article_source]})"
                   else
                     article[:article_title]
                   end %>
                <%# A button rather than a link: opening an article costs Google and the %>
                <%# publisher a visit, and a browser that fetches links ahead of the %>
                <%# cursor must not spend that on headlines nobody chose. No token: the %>
                <%# action only bounces to the article's GET, and forty tokens would %>
                <%# weigh the list down. %>
                <li><%= choice_button label, news_open_path,
                                      { article: article[:article_url],
                                        section: @section,
                                        title: article[:article_title] },
                                      token: false %></li>
            <% end %>
            </ul>
            <br />
    <% end %>
</div>