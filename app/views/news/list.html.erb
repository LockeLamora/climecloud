
<div class='news_topics'>
<%= @error ? "<span class='error'>#{@error}</span><br />".html_safe : nil %>
<%= glyph_text @title.to_s %><br /><br />
<%= render 'sections', keyed: true %>
</div>
<br />
<div class='news_search'>
<%= form_with url:"news_search", method: :get, local: true do |f| %>
    <%= f.label(t('news.search_label')) { glyph_text t('news.search_label') } %>
    <%= f.text_field :search_query, class: "text_field" %>
    <br /><br />
    <%= f.submit t('common.search') %>
  <% end %>
</div>
<br /><br />
<div class="news">
    <% @news_items.each do |item| %>
            <% multi = item[:articles].length > 1 %>
            <%# The heading is the grouping: a story with several sources keeps it, and the
                sources sit indented beneath as outlet names alone — repeating the headline
                per source was the page that would not open, and a bare outlet name with no
                heading above it read as a headline that lost its text. A story with one
                source drops the heading and lets its lead carry the headline itself, or
                the same sentence stacks twice. %>
            <% if multi %>
            <b><%= glyph_text item[:item_title], heading: true %></b><br />
            <% end %>
            <ul>
            <% item[:articles].each do |article| %>
                <%# The section travels with the link so the way back lands on the list %>
                <%# being read, and the headline so an article that will not open can still %>
                <%# say what it was about. %>
                <% label = if multi
                     article[:article_source].presence || article[:article_title]
                   elsif article[:article_source].present?
                     "#{article[:article_title]} (#{article[:article_source]})"
                   else
                     article[:article_title]
                   end %>
                <%# A link like every other list in the app, so the handset's cursor %>
                <%# stops once per headline and the drawn styles keep their glyphs — but %>
                <%# it links to the free redirect rather than the article, so a prefetch %>
                <%# that stops at redirects spends nothing on headlines nobody chose. %>
                <li><%= link_to label,
                                news_open_path(article: article[:article_url],
                                               section: @section,
                                               title: article[:article_title]) %></li>
            <% end %>
            </ul>
            <br />
    <% end %>
<%# The feed's tail, a page at a time. No digits of their own — the sections hold all %>
<%# nine — so these are unnumbered, like the change-postcode link on the stops page. %>
<% pager = @search_query.present? ? ->(page) { news_search_path(search_query: @search_query, page: page) } : ->(page) { news_path(section: @section, page: page) } %>
<% if @more %>
<%= link_to "(#{t('news.more_stories')})", pager.call(@page + 1) %><br />
<% end %>
<% if @page.positive? %>
<%= link_to "(#{t('news.previous_stories')})", pager.call(@page - 1) %><br />
<% end %>
</div>
<br />
<div class='news_topics'>
<%# The sections again at the foot: a reader who has read a whole category down is at %>
<%# the bottom, and reaching the next one — or the menu — should not cost a screenful %>
<%# of scrolling back up. %>
<%= render 'sections', keyed: false %>
<%= link_to "0 #{t('common.back_to_menu')}", root_path, accesskey: "0" %>
</div>