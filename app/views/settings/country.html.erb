<div class='route'>
<%= phosphor_text t('settings.which_country') %><br />
<b><%= phosphor_text params[:postcode].to_s %></b>
<br /><br />
<%# Numbered with accesskeys, so confirming the country is one keypress rather than %>
<%# scrolling a dropdown of every country there is on a four way pad. %>
<% @countries.each_with_index do |code, index| %>
<%= button_to "#{index + 1} #{country_name(code)}", settings_save_path,
              params: @settings_params.merge('country_code' => code),
              accesskey: (index + 1).to_s, form_class: "inline-action" %><br />
<% end %>
<br />
<%= link_to "(#{t('common.none_of_these')})", settings_path %>
<%= render "shared/osm_credit" %>
</div>
