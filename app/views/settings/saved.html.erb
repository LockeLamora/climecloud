<div class='route'>
<%= t('settings.saved_as') %><br />
<b><%= cookies['city'].presence || @place %></b>
<br /><br />
<%# Always shown, even when there is only one choice: it is the only way back to a %>
<%# language you can read after moving to a country that speaks another. %>
<%= t('settings.language') %><br />
<% @languages.each_with_index do |locale, index| %>
<%= button_to "#{index + 1} #{Languages.name_for(locale)}", settings_language_path,
              params: { locale: locale },
              accesskey: (index + 1).to_s, form_class: "inline-action" %><br />
<% end %>
<br />
<%= link_to "0 #{t('common.continue')}", root_path, accesskey: "0" %><br /><br />
<% if @alternatives.positive? %>
<%= link_to "9 #{t('settings.wrong_place', count: @alternatives)}",
            settings_pick_path(@settings_params), accesskey: "9" %>
<% end %>
<%= render "shared/osm_credit" %>
</div>
