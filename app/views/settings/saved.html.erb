<div class='route'>
<%= t('settings.saved_as') %><br />
<b><%= cookies['city'].presence || @place %></b>
<br /><br />
<% if @languages.length > 1 %>
<%= t('settings.language') %><br />
<% @languages.each_with_index do |locale, index| %>
<%= link_to "#{index + 1} #{Languages.name_for(locale)}",
            settings_language_path(locale: locale),
            accesskey: (index + 1).to_s %><br />
<% end %>
<br />
<% end %>
<%= link_to "0 #{t('common.continue')}", root_path, accesskey: "0" %><br /><br />
<% if @alternatives.positive? %>
<%= link_to "9 #{t('settings.wrong_place', count: @alternatives)}",
            settings_pick_path(@settings_params), accesskey: "9" %>
<% end %>
</div>
