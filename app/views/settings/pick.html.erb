<div class='route'>
<%= glyph_text t('settings.other_places') %><br />
<b><%= glyph_text params[:postcode].to_s, heading: true %></b>
<br /><br />
<ol>
<% @candidates.each do |candidate| %>
    <li><%= button_to candidate[:address], settings_save_path,
                      params: @settings_params.merge('lat' => candidate[:lat],
                                                     'lon' => candidate[:lon],
                                                     'place' => candidate[:address],
                                                     'place_country' => candidate[:country_code]),
                      form_class: "inline-action" %></li>
<% end %>
</ol>
<br />
<%= link_to "(#{t('common.none_of_these')})", settings_path %>
<%= render "shared/osm_credit" %>
</div>
