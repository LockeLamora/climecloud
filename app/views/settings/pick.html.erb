<div class='route'>
<%= t('settings.other_places') %><br />
<b><%= params[:postcode] %></b>
<br /><br />
<ol>
<% @candidates.each do |candidate| %>
    <li><%= link_to candidate[:address], settings_save_path(@settings_params.merge('lat' => candidate[:lat],
                                                                                  'lon' => candidate[:lon],
                                                                                  'place' => candidate[:address],
                                                                                  'place_country' => candidate[:country_code])) %></li>
<% end %>
</ol>
<br />
<%= link_to "(#{t('common.none_of_these')})", settings_path %>
<%= render "shared/osm_credit" %>
</div>
